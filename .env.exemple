# ============================================================
# Fichier modèle — NE PAS mettre les vraies valeurs ici
# Copier ce fichier : cp .env.exemple .env
# Puis remplir les vraies valeurs dans .env (jamais versionné)
# Exigence R7 du sujet
# ============================================================

# Numéro de groupe (1 à 8)
GROUPE=7
# Nombre de serveurs applicatifs (minimum 2)
NB_APP=2

# ---- Base de données PostgreSQL ----
PG_USER=postgres
PG_PASSWORD=changez_moi
PG_DB=resultats_bf
PG_PORT=5432
PG_HOST=192.168.62.31

# ---- Réplication PostgreSQL ----
PG_REPLICATION_USER=replicateur
PG_REPLICATION_PASSWORD=changez_moi

# ---- Cache Redis (Extension E3) ----
REDIS_HOST=192.168.62.51
REDIS_PORT=6379
CACHE_TTL=300
CACHE_PREFIX=resultats