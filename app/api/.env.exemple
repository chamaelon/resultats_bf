# Exemple de fichier .env pour l'application RÉSULTATS-BF
# Exigence R7 du sujet : ce fichier est versionné.
# Le fichier .env réel (avec les vraies valeurs) ne l'est PAS.
#
# Marche à suivre :
#   cp app/api/.env.exemple app/api/.env
#   Puis remplissez les valeurs ci-dessous.

# Port d'écoute de l'API (80 pour la production)
PORT=80

# Connexion PostgreSQL
PG_USER=CHANGER_MOI
PG_PASSWORD=CHANGER_MOI
PG_PORT=5432
PG_DB=CHANGER_MOI

# PG_HOST est calculé automatiquement depuis noeuds.yml par app.sh
# Laisser vide ici.
PG_HOST=

# Utilisateur de réplication PostgreSQL (utilisé par bdd.sh et replique.sh)
PG_REPLICATION_USER=CHANGER_MOI
PG_REPLICATION_PASSWORD=CHANGER_MOI

# Mot de passe VRRP pour keepalived (Extension E1)
VRRP_AUTH_PASS=CHANGER_MOI
